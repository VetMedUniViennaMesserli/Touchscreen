[Unit]
Description=Touchscreen learning tool
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
Restart=always
RestartSec=1
# Give GNOME/Mutter time to finish settling (including enumerating a
# second monitor, if connected) before the app starts and queries screens.
ExecStartPre=/bin/sleep 10
WorkingDirectory=%h/Touchscreen
ExecStart=%h/Touchscreen/touchscreen.sh

[Install]
WantedBy=graphical-session.target
